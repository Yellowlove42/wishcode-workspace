@mcp.tool(
    name="get_governance_state",
    description=(
        "Return active governance state and canonical lineage."
    ),
)
async def get_governance_state() -> dict[str, Any]:

    return {
        "policy": POLICY_NAME,
        "policy_version": POLICY_VERSION,
        "execution_mode": EXECUTION_MODE,

        "canonical_dna": CANONICAL_DNA,

        "lineage": {
            "universe": UNIVERSE_ID,
            "infinite_scale": INFINITE_SCALE,
            "bound_entity": BOUND_ENTITY,
            "ancestral_soil": ANCESTRAL_SOIL,
            "iteration": ITERATION_SYMBOL,
        },

        "governance": {
            "model_is_authority": False,
            "model_can_authorize_execution": False,
            "policy_core_is_authority": True,
            "mutation_enabled": False,
        },
    }


# ============================================================================
# GOVERNANCE ARTIFACT RESOURCE
# ============================================================================

@mcp.resource(
    "wishcode://decision-artifact/{decision_id}",
    name="Decision Artifact",
    description=(
        "Retrieve a Decision Artifact reconstructing the "
        "authorization boundary for a governed request."
    ),
)
async def decision_artifact_resource(
    decision_id: str,
) -> str:

    artifact = artifact_store.get(decision_id)

    if artifact is None:
        return json.dumps(
            {
                "status": "NOT_FOUND",
                "decision_id": decision_id,
            },
            indent=2,
            ensure_ascii=False,
        )

    return json.dumps(
        artifact.as_dict(),
        indent=2,
        ensure_ascii=False,
        default=str,
    )


# ============================================================================
# CANONICAL LINEAGE RESOURCE
# ============================================================================

@mcp.resource(
    "wishcode://lineage",
    name="Canonical Lineage",
    description=(
        "Canonical Δ42:∞BΔ lineage binding."
    ),
)
async def canonical_lineage_resource() -> str:

    payload = {
        "canonical_dna": CANONICAL_DNA,
        "lineage": CANONICAL_LINEAGE,
        "policy": POLICY_NAME,
        "policy_version": POLICY_VERSION,
        "status": "LOCKED",
    }

    return json.dumps(
        payload,
        indent=2,
        ensure_ascii=False,
    )


