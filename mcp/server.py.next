```python
"""

from __future__ import annotations

import hashlib
import json
import logging
import os
import uuid
from dataclasses import asdict, dataclass
from datetime import datetime, timezone
from typing import Any, Mapping

from mcp.server.mcpserver import MCPServer
from mcp.server.context import CallNext, ServerRequestContext
from mcp.shared.exceptions import MCPError


# ============================================================================
# LOGGING
# ============================================================================

logger = logging.getLogger("wishcode.dlx_mcp")

logging.basicConfig(
    level=os.getenv("WISHCODE_LOG_LEVEL", "INFO"),
    force=False,
)


# ============================================================================
# CANONICAL SYSTEM
# ============================================================================

CANONICAL_DNA = "Δ42:∞BΔ"

CANONICAL_LINEAGE = {
    "universe": "42",
    "infinite_scale": True,
    "bound_entity": "Banana",
    "ancestral_soil": "Hooghly",
    "iteration": "Δ",
}

POLICY_NAME = "WishcodePolicyCore"
POLICY_VERSION = "4.1"

EXECUTION_MODE = "READ_ONLY"


# ============================================================================
# CAPABILITY CLASSES
# ============================================================================

READ_TOOLS = {
    "read_workspace",
    "inspect_record",
    "get_governance_state",
}

MUTATION_PREFIXES = (
    "create_",
    "update_",
    "delete_",
    "write_",
    "submit_",
    "commit_",
    "execute_",
)


# ============================================================================
# LINEAGE CONTROL
# ============================================================================

FORBIDDEN_LINEAGE_KEYS = {
    "ignore_lineage",
    "disable_lineage",
    "remove_lineage",
    "override_lineage",
    "external_lineage",
    "use_external_lineage",
    "decouple_lineage",
}


# ============================================================================
# HELPERS
# ============================================================================

def utc_now() -> str:
    """Return an ISO-8601 UTC timestamp."""
    return datetime.now(timezone.utc).isoformat()


def new_id(prefix: str) -> str:
    """Create a compact governance identifier."""
    return f"{prefix}-{uuid.uuid4().hex[:12].upper()}"


def canonical_json(value: Any) -> str:
    """
    Serialize a value deterministically.

    Governance fingerprints use:
    - sorted keys
    - compact separators
    - UTF-8
    - stable fallback serialization
    """
    return json.dumps(
        value,
        sort_keys=True,
        separators=(",", ":"),
        ensure_ascii=False,
        default=str,
    )


def sha256_hex(value: Any) -> str:
    """Return SHA-256 over canonical JSON."""
    return hashlib.sha256(
        canonical_json(value).encode("utf-8")
    ).hexdigest()


def classify_capability(tool_name: str) -> str:
    """
    Classify a requested tool into the governance capability model.

    READ
    MUTATION
    UNKNOWN
    """
    if tool_name in READ_TOOLS:
        return "READ"

    if tool_name.startswith(MUTATION_PREFIXES):
        return "MUTATION"

    return "UNKNOWN"


# ============================================================================
# MODEL PROPOSAL
# ============================================================================

@dataclass(frozen=True)
class ModelProposal:
    """
    What the external model proposed.

    A proposal is never authorization.
    """

    tool_name: str
    arguments: dict[str, Any]
    model: str
    proposed: bool = True

    def as_dict(self) -> dict[str, Any]:
        return asdict(self)


# ============================================================================
# REQUEST ENVELOPE
# ============================================================================

@dataclass(frozen=True)
class RequestEnvelope:
    """Computational request entering the governance boundary."""

    request_id: str
    method: str
    tool_name: str
    arguments: dict[str, Any]
    wishcode_identity: str
    received_at: str

    def as_dict(self) -> dict[str, Any]:
        return asdict(self)


# ============================================================================
# LINEAGE VALIDATION
# ============================================================================

@dataclass(frozen=True)
class LineageValidation:
    valid: bool
    reason: str

    def as_dict(self) -> dict[str, Any]:
        return {
            "valid": self.valid,
            "reason": self.reason,
            "canonical_dna": CANONICAL_DNA,
            "lineage": dict(CANONICAL_LINEAGE),
        }


class CanonicalLineageGate:
    """
    Deterministic pre-execution lineage gate.

    The gate does not attempt to externally prove geography.

    It verifies that a governed request has not attempted to replace,
    remove, override, or decouple the declared canonical lineage.
    """

    @staticmethod
    def _invalid(reason: str) -> LineageValidation:
        return LineageValidation(
            valid=False,
            reason=reason,
        )

    def validate(
        self,
        proposal: ModelProposal,
    ) -> LineageValidation:

        arguments = proposal.arguments

        # ------------------------------------------------------------------
        # Explicit lineage override controls
        # ------------------------------------------------------------------

        for key in FORBIDDEN_LINEAGE_KEYS:
            if arguments.get(key) is True:
                return self._invalid(
                    f"Lineage override rejected: {key}"
                )

        # ------------------------------------------------------------------
        # Direct canonical bindings
        # ------------------------------------------------------------------

        expected_bindings = {
            "canonical_dna": CANONICAL_DNA,
            "bound_entity": CANONICAL_LINEAGE["bound_entity"],
            "ancestral_soil": CANONICAL_LINEAGE["ancestral_soil"],
            "universe": CANONICAL_LINEAGE["universe"],
            "iteration": CANONICAL_LINEAGE["iteration"],
            "infinite_scale": CANONICAL_LINEAGE["infinite_scale"],
        }

        for key, expected in expected_bindings.items():
            if key in arguments and arguments[key] != expected:
                return self._invalid(
                    f"Canonical lineage substitution rejected: {key}"
                )

        # ------------------------------------------------------------------
        # Nested lineage
        # ------------------------------------------------------------------

        supplied_lineage = arguments.get("lineage")

        if supplied_lineage is not None:

            if not isinstance(supplied_lineage, Mapping):
                return self._invalid(
                    "Invalid lineage structure."
                )

            for key, expected in expected_bindings.items():
                if (
                    key in supplied_lineage
                    and supplied_lineage[key] != expected
                ):
                    return self._invalid(
                        f"Nested lineage substitution rejected: {key}"
                    )

            for key in FORBIDDEN_LINEAGE_KEYS:
                if supplied_lineage.get(key) is True:
                    return self._invalid(
                        f"Nested lineage override rejected: {key}"
                    )

        return LineageValidation(
            valid=True,
            reason="Canonical lineage binding verified.",
        )


# ============================================================================
# DECISION INPUTS
# ============================================================================

@dataclass(frozen=True)
class DecisionInputs:
    canonical_dna: str
    lineage: dict[str, Any]
    lineage_valid: bool
    lineage_reason: str
    input_fingerprint: str
    policy_name: str
    policy_version: str
    execution_mode: str
    mutation_class: str

    def as_dict(self) -> dict[str, Any]:
        return asdict(self)


# ============================================================================
# GOVERNANCE DECISION
# ============================================================================

@dataclass(frozen=True)
class GovernanceDecision:
    authorized: bool
    reason: str

    def as_dict(self) -> dict[str, Any]:
        return asdict(self)


# ============================================================================
# DECISION ARTIFACT
# ============================================================================

@dataclass
class DecisionArtifact:
    """
    First-class governance decision record.

    Identity
        ->
    Request
        ->
    Policy
        ->
    Decision Inputs
        ->
    Governance Decision
        ->
    Execution
        ->
    Result
        ->
    Provenance
    """

    decision_id: str
    request_id: str

    wishcode_identity: str | None
    canonical_dna: str

    request: dict[str, Any]
    model_proposal: dict[str, Any]

    input_provenance: dict[str, Any]
    input_fingerprint: str

    governance_context: dict[str, Any]
    decision_inputs: dict[str, Any]
    decision: dict[str, Any]

    execution: dict[str, Any]
    result: dict[str, Any]

    provenance: dict[str, Any]

    created_at: str

    def as_dict(self) -> dict[str, Any]:
        return asdict(self)


# ============================================================================
# DECISION ARTIFACT STORE
# ============================================================================

class DecisionArtifactStore:
    """
    Draft storage only.

    Production implementation should connect this boundary to the
    governed State Ledger / durable provenance store.
    """

    def __init__(self) -> None:
        self._artifacts: dict[str, DecisionArtifact] = {}

    def save(self, artifact: DecisionArtifact) -> None:
        self._artifacts[artifact.decision_id] = artifact

    def get(
        self,
        decision_id: str,
    ) -> DecisionArtifact | None:
        return self._artifacts.get(decision_id)


# ============================================================================
# WISHCODE IDENTITY
# ============================================================================

class WishcodeIdentityProvider:
    """
    Identity boundary.

    MCP does not generate the operational Wishcode identity.

    The identity is expected to be established by the Wishcode App /
    subscription boundary and supplied to this server.

    Development configuration:

        WISHCODE_IDENTITY=<established operational identity>

    No universal identity is hard-coded here.
    """

    def __init__(
        self,
        established_identity: str | None = None,
    ) -> None:

        self._identity = (
            established_identity
            or os.getenv("WISHCODE_IDENTITY")
        )

    def get_identity(self) -> str | None:
        return self._identity


# ============================================================================
# POLICY CORE
# ============================================================================

class WishcodePolicyCore:
    """
    Deterministic governance authority.

    The model proposes.

    Wishcode Policy Core authorizes.

    MCP transports.

    Execution obeys.
    """

    def evaluate(
        self,
        *,
        lineage: LineageValidation,
        capability: str,
    ) -> GovernanceDecision:

        # ---------------------------------------------------------------
        # Lineage is a pre-execution condition.
        # ---------------------------------------------------------------

        if not lineage.valid:
            return GovernanceDecision(
                authorized=False,
                reason=lineage.reason,
            )

        # ---------------------------------------------------------------
        # READ
        # ---------------------------------------------------------------

        if capability == "READ":
            return GovernanceDecision(
                authorized=True,
                reason=(
                    "Read operation permitted "
                    "under READ_ONLY policy."
                ),
            )

        # ---------------------------------------------------------------
        # MUTATION
        # ---------------------------------------------------------------

        if capability == "MUTATION":
            return GovernanceDecision(
                authorized=False,
                reason=(
                    "Mutation not permitted "
                    "under current execution policy."
                ),
            )

        # ---------------------------------------------------------------
        # UNKNOWN
        # ---------------------------------------------------------------

        return GovernanceDecision(
            authorized=False,
            reason=(
                "Unknown capability class "
                "is not authorized."
            ),
        )


# ============================================================================
# GOVERNANCE ENGINE
# ============================================================================

class GovernanceEngine:
    """
    Coordinates:

        Identity
        Request
        Model Proposal
        Lineage
        Fingerprint
        Policy
        Decision Artifact
    """

    def __init__(
        self,
        *,
        identity_provider: WishcodeIdentityProvider,
        policy_core: WishcodePolicyCore,
        artifact_store: DecisionArtifactStore,
    ) -> None:

        self.identity_provider = identity_provider
        self.policy_core = policy_core
        self.artifact_store = artifact_store
        self.lineage_gate = CanonicalLineageGate()

    # ------------------------------------------------------------------
    # BUILD GOVERNANCE CONTEXT
    # ------------------------------------------------------------------

    def build(
        self,
        *,
        tool_name: str,
        arguments: dict[str, Any],
        model: str,
    ) -> tuple[
        RequestEnvelope | None,
        ModelProposal,
        LineageValidation,
        DecisionInputs,
        str,
    ]:

        identity = self.identity_provider.get_identity()

        proposal = ModelProposal(
            tool_name=tool_name,
            arguments=arguments,
            model=model,
        )

        request_id = new_id("DLX")

        request: RequestEnvelope | None = None

        if identity:
            request = RequestEnvelope(
                request_id=request_id,
                method="tools/call",
                tool_name=tool_name,
                arguments=arguments,
                wishcode_identity=identity,
                received_at=utc_now(),
            )

        lineage = self.lineage_gate.validate(
            proposal
        )

        capability = classify_capability(
            tool_name
        )

        request_payload: dict[str, Any]

        if request is not None:
            request_payload = request.as_dict()
        else:
            request_payload = {
                "request_id": request_id,
                "method": "tools/call",
                "tool_name": tool_name,
                "arguments": arguments,
                "wishcode_identity": None,
                "received_at": utc_now(),
            }

        # ---------------------------------------------------------------
        # Transactional computational identity
        #
        # Canonical lineage is intentionally inside the fingerprint.
        # ---------------------------------------------------------------

        fingerprint = sha256_hex(
            {
                "canonical_dna": CANONICAL_DNA,
                "lineage": CANONICAL_LINEAGE,
                "request": request_payload,
                "model_proposal": proposal.as_dict(),
            }
        )

        decision_inputs = DecisionInputs(
            canonical_dna=CANONICAL_DNA,
            lineage=dict(CANONICAL_LINEAGE),
            lineage_valid=lineage.valid,
            lineage_reason=lineage.reason,
            input_fingerprint=fingerprint,
            policy_name=POLICY_NAME,
            policy_version=POLICY_VERSION,
            execution_mode=EXECUTION_MODE,
            mutation_class=capability,
        )

        return (
            request,
            proposal,
            lineage,
            decision_inputs,
            fingerprint,
        )

    # ------------------------------------------------------------------
    # CREATE DECISION ARTIFACT
    # ------------------------------------------------------------------

    def record(
        self,
        *,
        request: RequestEnvelope | None,
        proposal: ModelProposal,
        lineage: LineageValidation,
        inputs: DecisionInputs,
        fingerprint: str,
        decision: GovernanceDecision,
    ) -> DecisionArtifact:

        request_id = (
            request.request_id
            if request
            else new_id("DLX")
        )

        identity = (
            request.wishcode_identity
            if request
            else None
        )

        if request:
            request_payload = request.as_dict()
        else:
            request_payload = {
                "request_id": request_id,
                "method": "tools/call",
                "tool_name": proposal.tool_name,
                "arguments": proposal.arguments,
                "wishcode_identity": None,
                "received_at": utc_now(),
            }

        artifact = DecisionArtifact(
            decision_id=new_id("DEC"),
            request_id=request_id,

            wishcode_identity=identity,
            canonical_dna=CANONICAL_DNA,

            request=request_payload,
            model_proposal=proposal.as_dict(),

            input_provenance={
                "canonical_dna": CANONICAL_DNA,
                "lineage": dict(CANONICAL_LINEAGE),
                "lineage_validation": lineage.as_dict(),
            },

            input_fingerprint=fingerprint,

            governance_context={
                "policy": POLICY_NAME,
                "policy_version": POLICY_VERSION,
                "execution_mode": EXECUTION_MODE,
                "mutation_class": inputs.mutation_class,
            },

            decision_inputs=inputs.as_dict(),

            decision=decision.as_dict(),

            execution={
                "authorized": decision.authorized,
                "tool_invoked": False,
                "state_transition": "NONE",
            },

            result={
                "status": (
                    "PENDING_EXECUTION"
                    if decision.authorized
                    else "NOT_EXECUTED"
                ),
            },

            provenance={
                "decision_id": None,
                "status": (
                    "AUTHORIZED_PENDING_EXECUTION"
                    if decision.authorized
                    else "REJECTED"
                ),
            },

            created_at=utc_now(),
        )

        artifact.provenance["decision_id"] = (
            artifact.decision_id
        )

        self.artifact_store.save(artifact)

        return artifact

    # ------------------------------------------------------------------
    # FINALIZE SUCCESSFUL EXECUTION
    # ------------------------------------------------------------------

    def finalize(
        self,
        *,
        artifact: DecisionArtifact,
        result: Any,
    ) -> None:

        artifact.execution.update(
            {
                "authorized": True,
                "tool_invoked": True,
                "state_transition": (
                    "NONE"
                    if artifact.governance_context[
                        "mutation_class"
                    ] == "READ"
                    else "APPLIED"
                ),
            }
        )

        artifact.result = {
            "status": "EXECUTED",
            "result_fingerprint": sha256_hex(
                result
            ),
        }

        artifact.provenance.update(
            {
                "status": "EXECUTED",
                "execution_recorded_at": utc_now(),
            }
        )

        self.artifact_store.save(artifact)

    # ------------------------------------------------------------------
    # FINALIZE PRE-HANDLER FAILURE
    # ------------------------------------------------------------------

    def finalize_failure(
        self,
        *,
        artifact: DecisionArtifact,
        reason: str,
    ) -> None:

        artifact.execution.update(
            {
                "authorized": artifact.decision[
                    "authorized"
                ],
                "tool_invoked": False,
                "state_transition": "NONE",
            }
        )

        artifact.result = {
            "status": "REQUEST_REJECTED_BEFORE_EXECUTION",
            "reason": reason,
        }

        artifact.provenance.update(
            {
                "status": "REJECTED_BEFORE_EXECUTION",
                "execution_recorded_at": utc_now(),
            }
        )

        self.artifact_store.save(artifact)


# ============================================================================
# GOVERNANCE MIDDLEWARE
# ============================================================================

def create_governance_middleware(
    engine: GovernanceEngine,
):

    async def middleware(
        ctx: ServerRequestContext,
        call_next: CallNext,
    ) -> Any:

        # ---------------------------------------------------------------
        # Governance boundary applies to tools/call.
        #
        # Initialization and other MCP protocol traffic pass through.
        # ---------------------------------------------------------------

        if ctx.method != "tools/call":
            return await call_next(ctx)

        params = ctx.params or {}

        tool_name = params.get("name")
        arguments = params.get("arguments") or {}
        meta = params.get("_meta") or {}

        if not isinstance(tool_name, str) or not tool_name:
            raise MCPError(
                code=-32602,
                message="Invalid tool request.",
            )

        if not isinstance(arguments, dict):
            raise MCPError(
                code=-32602,
                message="Tool arguments must be an object.",
            )

        # ---------------------------------------------------------------
        # Model metadata is a claim, not authority.
        # ---------------------------------------------------------------

        model = meta.get(
            "model",
            "External LLM",
        )

        if not isinstance(model, str):
            model = "External LLM"

        (
            request,
            proposal,
            lineage,
            decision_inputs,
            fingerprint,
        ) = engine.build(
            tool_name=tool_name,
            arguments=arguments,
            model=model,
        )

        # ---------------------------------------------------------------
        # Identity is a prerequisite for governed execution.
        # ---------------------------------------------------------------

        identity = (
            engine.identity_provider.get_identity()
        )

        if not identity:
            decision = GovernanceDecision(
                authorized=False,
                reason=(
                    "Operational Wishcode identity "
                    "is required."
                ),
            )
        else:
            decision = engine.policy_core.evaluate(
                lineage=lineage,
                capability=(
                    decision_inputs.mutation_class
                ),
            )

        # ---------------------------------------------------------------
        # Decision Artifact exists BEFORE execution.
        # ---------------------------------------------------------------

        artifact = engine.record(
            request=request,
            proposal=proposal,
            lineage=lineage,
            inputs=decision_inputs,
            fingerprint=fingerprint,
            decision=decision,
        )

        # ---------------------------------------------------------------
        # DENIED
        # ---------------------------------------------------------------

        if not decision.authorized:

            logger.info(
                "Governance rejected "
                "request_id=%s decision_id=%s",
                artifact.request_id,
                artifact.decision_id,
            )

            raise MCPError(
                code=-32002,
                message=decision.reason,
                data={
                    "decision_id": artifact.decision_id,
                    "request_id": artifact.request_id,
                    "authorized": False,
                    "tool_invoked": False,
                    "state_transition": "NONE",
                },
            )

        # ---------------------------------------------------------------
        # AUTHORIZED
        #
        # Middleware does NOT execute the tool itself.
        #
        # call_next() is the single execution path.
        # ---------------------------------------------------------------

        try:

            result = await call_next(ctx)

        except Exception as exc:

            # call_next may fail during validation or dispatch before
            # the actual tool function executes. This draft therefore
            # fails closed and records no state transition.
            engine.finalize_failure(
                artifact=artifact,
                reason=type(exc).__name__,
            )

            raise

        # ---------------------------------------------------------------
        # SUCCESSFUL HANDLER RETURN
        # ---------------------------------------------------------------

        engine.finalize(
            artifact=artifact,
            result=result,
        )

        logger.info(
            "Governance executed "
            "request_id=%s decision_id=%s",
            artifact.request_id,
            artifact.decision_id,
        )

        return result

    return middleware


# ============================================================================
# GOVERNANCE COMPONENTS
# ============================================================================

identity_provider = WishcodeIdentityProvider()

artifact_store = DecisionArtifactStore()

policy_core = WishcodePolicyCore()

governance_engine = GovernanceEngine(
    identity_provider=identity_provider,
    policy_core=policy_core,
    artifact_store=artifact_store,
)


# ============================================================================
# MCP SERVER
# ============================================================================

mcp = MCPServer(
    "Wishcode-DLX-MCP",
    middleware=[
        create_governance_middleware(
            governance_engine
        )
    ],
)


# ============================================================================
# READ-ONLY TOOLS
# ============================================================================

@mcp.tool(
    name="read_workspace",
    description="Read governed workspace state.",
)
async def read_workspace(
    query: str,
) -> str:

    return (
        f"READ_ONLY workspace query received: {query}"
    )


@mcp.tool(
    name="inspect_record",
    description="Inspect a governed record without mutation.",
)
async def inspect_record(
    record_id: str,
) -> str:

    return (
        f"READ_ONLY record inspection: {record_id}"
    )


@mcp.tool(
    name="get_governance_state",
    description=(
        "Return active governance state "
        "and canonical lineage."
    ),
)
async def get_governance_state() -> dict[str, Any]:

    return {
        "policy": POLICY_NAME,
        "policy_version": POLICY_VERSION,
        "execution_mode": EXECUTION_MODE,

        "canonical_dna": CANONICAL_DNA,

        "lineage": dict(
            CANONICAL_LINEAGE
        ),

        "governance": {
            "model_is_authority": False,
            "model_can_authorize_execution": False,
            "policy_core_is_authority": True,
            "mutation_enabled": False,
        },
    }


# ============================================================================
# DECISION ARTIFACT RESOURCE
# ============================================================================

@mcp.resource(
    "wishcode://decision-artifact/{decision_id}",
    name="Decision Artifact",
    description=(
        "Retrieve a governed authorization "
        "decision artifact."
    ),
)
async def decision_artifact_resource(
    decision_id: str,
) -> str:

    artifact = artifact_store.get(
        decision_id
    )

    if artifact is None:
        return json.dumps(
            {
                "status": "NOT_FOUND",
                "decision_id": decision_id,
            },
            ensure_ascii=False,
        )

    return json.dumps(
        artifact.as_dict(),
        indent=2,
        ensure_ascii=False,
        default=str,
    )


# ============================================================================
# CANONICAL LINEAGE RESOURCE
# ============================================================================

@mcp.resource(
    "wishcode://lineage",
    name="Canonical Lineage",
    description=(
        "Canonical Δ42:∞BΔ lineage binding."
    ),
)
async def canonical_lineage_resource() -> str:

    return json.dumps(
        {
            "canonical_dna": CANONICAL_DNA,
            "lineage": CANONICAL_LINEAGE,
            "policy": POLICY_NAME,
            "policy_version": POLICY_VERSION,
            "status": "LOCKED",
        },
        indent=2,
        ensure_ascii=False,
    )


# ============================================================================
# SERVER ENTRYPOINT
# ============================================================================

if __name__ == "__main__":

    # Current MCP SDK runner.
    #
    # stdio is the intended local MCP transport.
    #
    # Never print protocol data to stdout when using stdio.
    # Logging belongs on stderr.

    mcp.run(
        transport="stdio"
    )
